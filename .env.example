OPENVELOPE_CONFIG=/etc/openvelope/config.yaml
WEBMAIL_SERVER_HOST=0.0.0.0
WEBMAIL_SERVER_PORT=8080

DATABASE_URL=postgres://user:pass@host:5432/openvelope?sslmode=require
# or:
WEBMAIL_DATABASE_HOST=localhost
WEBMAIL_DATABASE_PORT=5432
OPENVELOPE_DATABASE_USER=openvelope
OPENVELOPE_DATABASE_PASSWORD=openvelope
OPENVELOPE_DATABASE_DBNAME=openvelope
WEBMAIL_DATABASE_SSLMODE=disable

WEBMAIL_IMAP_HOST=mail.example.com
WEBMAIL_IMAP_PORT=993
WEBMAIL_IMAP_TLS=true

WEBMAIL_SMTP_HOST=mail.example.com
WEBMAIL_SMTP_PORT=587
WEBMAIL_SMTP_STARTTLS=true

WEBMAIL_SESSION_JWT_SECRET=...
WEBMAIL_SESSION_ENCRYPTION_KEY=...
WEBMAIL_SESSION_ACCESS_TOKEN_TTL=15m
WEBMAIL_SESSION_REFRESH_TOKEN_TTL=168h

WEBMAIL_SMTP_RELAY_ENABLED=true
WEBMAIL_SMTP_RELAY_HOST=smtp.example.com
WEBMAIL_SMTP_RELAY_PORT=587
WEBMAIL_SMTP_RELAY_USERNAME=relay-user
WEBMAIL_SMTP_RELAY_PASSWORD=relay-pass
WEBMAIL_SMTP_RELAY_AUTH=plain
